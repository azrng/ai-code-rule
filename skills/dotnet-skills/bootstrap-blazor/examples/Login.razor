@page "/login"
@using BootstrapBlazor.Components

<PageTitle>登录</PageTitle>

<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <Card style="width: 380px;" IsShadow="true">
        <HeaderTemplate><h4 class="mb-0">用户登录</h4></HeaderTemplate>
        <BodyTemplate>
            <ValidateForm Model="@_model" OnValidSubmit="OnLogin" OnInvalidSubmit="OnInvalid"
                          ShowRequiredMark="true" ValidateAllProperties="true">
                <div class="mb-3">
                    <BootstrapInput @bind-Value="_model.UserName" DisplayText="用户名"
                                    PlaceHolder="请输入用户名" ShowLabel="true" IsAutoFocus="true" />
                </div>
                <div class="mb-3">
                    <BootstrapInput @bind-Value="_model.Password" DisplayText="密码"
                                    PlaceHolder="请输入密码" ShowLabel="true" />
                </div>
                <div class="mb-3">
                    <CheckboxList @bind-Value="_model.Options" Items="_rememberItems" IsVertical="false" />
                </div>
                <Button Type="ButtonType.Submit" Color="Color.Primary" Text="登录" Icon="fa-solid fa-right-to-bracket" />
                <Button Color="Color.Secondary" Text="重置" OnClick="OnReset" />
            </ValidateForm>
        </BodyTemplate>
    </Card>
</div>

@code {
    [Inject] ToastService ToastService { get; set; } = null!;

    private LoginModel _model = new();

    private readonly List<SelectedItem> _rememberItems = new()
    {
        new("remember", "记住我")
    };

    private async Task OnLogin(EditContext ctx)
    {
        // 真实项目在此调用 UserService.LoginAsync(_model)，校验成功后导航
        await ToastService.Success("登录成功", $"欢迎 {_model.UserName}");
        _model = new LoginModel();
    }

    private Task OnInvalid(EditContext ctx)
    {
        return ToastService.Error("登录失败", "请完整填写用户名和密码");
    }

    private void OnReset() => _model = new LoginModel();

    public class LoginModel
    {
        [Required(ErrorMessage = "请输入用户名")]
        public string UserName { get; set; } = "";

        [Required(ErrorMessage = "请输入密码")]
        public string Password { get; set; } = "";

        public IEnumerable<string> Options { get; set; } = new List<string>();
    }
}
