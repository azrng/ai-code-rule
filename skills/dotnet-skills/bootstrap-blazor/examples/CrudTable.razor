@* 设备管理 CRUD（Test2/4）：模糊搜索 + 服务端分页 + 多选 + 增删改（自定义 Modal 编辑 + 行内 PopConfirm 删除） *@
@page "/devices"
@using BootstrapBlazor.Components

<PageTitle>设备管理</PageTitle>

<div class="container-fluid">
    <Card class="mb-3">
        <BodyTemplate>
            <Button Color="Color.Primary" Icon="fa-solid fa-plus" Text="新增" OnClick="OnAdd" />
            <Button Color="Color.Success" Icon="fa-solid fa-sync" Text="刷新" OnClick="OnRefresh" />
        </BodyTemplate>
    </Card>

    <Table TItem="FormModal.Device" @ref="_table"
           OnQueryAsync="OnQueryAsync"
           IsPagination="true" PageItemsSource="new[] { 10, 20, 50 }"
           IsStriped="true" IsBordered="true"
           IsMultipleSelect="true" ShowExtendButtons="true"
           ShowExtendEditButton="false" ShowExtendDeleteButton="false"
           ShowSearch="true" ShowSearchText="true"
           ShowLineNo="true" ShowEmpty="true">
        <TableColumns>
            <TableColumn @bind-Field="context.Name" Text="名称" Searchable="true" />
            <TableColumn @bind-Field="context.IP" Text="IP" Width="140" />
            <TableColumn @bind-Field="context.Port" Text="端口" Width="80" />
            <TableColumn @bind-Field="context.Enabled" Text="状态" Width="80">
                <Template Context="v">
                    <Badge Color="@(v.Value ? Color.Success : Color.Danger)">
                        @(v.Value ? "在线" : "离线")
                    </Badge>
                </Template>
            </TableColumn>
        </TableColumns>
        <RowButtonTemplate>
            <TableCellButton Size="Size.ExtraSmall" Color="Color.Success" Icon="fa-solid fa-edit" Text="编辑"
                             OnClick="@(() => OnEdit(context))" />
            <TableCellPopConfirmButton Size="Size.ExtraSmall" Color="Color.Danger" Icon="fa-solid fa-trash"
                                       Text="删除" Content="确定删除该设备吗？"
                                       OnConfirm="@(() => OnDelete(context))" />
        </RowButtonTemplate>
    </Table>

    <FormModal @ref="_edit" OnSaved="OnDeviceSaved" />
</div>

@code {
    [Inject] ToastService ToastService { get; set; } = null!;

    private Table<FormModal.Device>? _table;
    private FormModal? _edit;

    // 内存 mock 数据
    private static readonly List<FormModal.Device> _data = new()
    {
        new() { Id = 1, Name = "网关A", IP = "192.168.1.1", Port = 8080, Enabled = true, Description = "主网关" },
        new() { Id = 2, Name = "网关B", IP = "192.168.1.2", Port = 8081, Enabled = false, Description = "备网关" },
        new() { Id = 3, Name = "节点C", IP = "10.0.0.3", Port = 9000, Enabled = true, Description = "计算节点" }
    };

    // 服务端查询：模糊搜索 + 分页
    private Task<QueryData<FormModal.Device>> OnQueryAsync(QueryPageOptions opt)
    {
        var q = _data.AsEnumerable();
        if (!string.IsNullOrEmpty(opt.SearchText))
            q = q.Where(x => x.Name.Contains(opt.SearchText) || x.IP.Contains(opt.SearchText));

        var total = q.Count();
        var page = q.Skip((opt.PageIndex - 1) * opt.PageItems).Take(opt.PageItems).ToList();

        return Task.FromResult(new QueryData<FormModal.Device>
        {
            Items = page,
            TotalCount = total,
            IsFiltered = true,
            IsSorted = true,
            IsSearch = true,
            IsAdvanceSearch = true
        });
    }

    private async Task OnDelete(FormModal.Device item)
    {
        _data.RemoveAll(x => x.Id == item.Id);
        await ToastService.Success("消息通知", "删除成功");
        await OnRefresh();
    }

    private async Task OnAdd()
    {
        if (_edit != null) await _edit.Show(null);
    }

    private async Task OnEdit(FormModal.Device item)
    {
        if (_edit != null) await _edit.Show(item);
    }

    private async Task OnDeviceSaved(FormModal.Device d)
    {
        var exist = _data.FirstOrDefault(x => x.Id == d.Id);
        if (exist == null)
        {
            d.Id = _data.Count > 0 ? _data.Max(x => x.Id) + 1 : 1;
            _data.Insert(0, d);
        }
        else
        {
            var idx = _data.IndexOf(exist);
            _data[idx] = d;
        }
        await OnRefresh();
    }

    private async Task OnRefresh()
    {
        if (_table != null) await _table.QueryAsync();
    }
}
