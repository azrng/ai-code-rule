@* 后台管理主布局（Test3）：左侧 Menu + 顶部 Header + 主 Content（Tab 多标签） *@
@inherits LayoutComponentBase
@using BootstrapBlazor.Components

<Layout IsFullSide="true"
        IsPage="true"
        IsFixedHeader="true"
        IsFixedTabHeader="true"
        UseTabSet="true"
        SideWidth="260"
        ShowCollapseBar="true"
        ShowGotoTop="true"
        TabDefaultUrl="/"
        Menus="@Menus"
        AdditionalAssemblies="@AdditionalAssemblies"
        IsCollapsed="@_collapsed"
        IsCollapsedChanged="OnCollapsedChanged">
    <Header>
        <div class="d-flex align-items-center justify-content-between flex-fill">
            <div class="d-flex align-items-center">
                <img src="/_content/BootstrapBlazor/img/logo.png" height="32" alt="logo" />
                <span class="ms-2 fw-bold">后台管理系统</span>
            </div>
            <Logout ImageUrl="" DisplayName="@_userName" UserName="@_userName">
                <LinkTemplate>
                    <a href="/profile" class="dropdown-item"><i class="fa-solid fa-suitcase"></i> 个人中心</a>
                    <LogoutLink></LogoutLink>
                </LinkTemplate>
            </Logout>
        </div>
    </Header>
    <Side></Side>
    <Main>
        <ErrorLogger>
            @Body
        </ErrorLogger>
    </Main>
    <Footer>
        <div class="text-center flex-fill">Copyright © 2026 BootstrapBlazor</div>
    </Footer>
</Layout>

@code {
    private bool _collapsed;
    private string _userName = "管理员";

    private List<MenuItem> Menus { get; } = new()
    {
        new MenuItem("首页", "/") { Icon = "fa-solid fa-house" },
        new MenuItem("设备管理", "/devices") { Icon = "fa-solid fa-server" },
        new MenuItem("系统管理") { Icon = "fa-solid fa-gear",
            Items = new List<MenuItem>
            {
                new("用户管理", "/users") { Icon = "fa-solid fa-users" },
                new("角色管理", "/roles") { Icon = "fa-solid fa-user-shield" }
            }
        }
    };

    private IEnumerable<System.Reflection.Assembly> AdditionalAssemblies
        => new[] { GetType().Assembly };

    private Task OnCollapsedChanged(bool collapsed)
    {
        _collapsed = collapsed;
        return Task.CompletedTask;
    }
}
