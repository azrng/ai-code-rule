@page "/"
@using BootstrapBlazor.Components

<PageTitle>首页</PageTitle>

<div class="container-fluid">
    <Card class="mb-3">
        <HeaderTemplate><h5 class="mb-0">欢迎使用 BootstrapBlazor</h5></HeaderTemplate>
        <BodyTemplate>
            <Row ItemsPerRow="ItemsPerRow.Three">
                <div>
                    <Badge Color="Color.Primary">v10.9.2</Badge>
                    <Spinner Color="Color.Primary" />
                </div>
                <div>
                    <Button Color="Color.Success" Icon="fa-solid fa-check" Text="成功" OnClick="OnSuccess" />
                </div>
                <div>
                    <Progress Value="60" />
                </div>
            </Row>
        </BodyTemplate>
    </Card>

    <Divider Text="表单示例" />

    <ValidateForm Model="@_model" OnValidSubmit="OnSubmit" ShowRequiredMark="true">
        <Row ItemsPerRow="ItemsPerRow.Two">
            <div>
                <BootstrapInput @bind-Value="_model.Name" DisplayText="姓名" PlaceHolder="请输入姓名" ShowLabel="true" />
            </div>
            <div>
                <Select @bind-Value="_model.City" Items="_cities" DisplayText="城市" ShowLabel="true" ShowSearch="true" />
            </div>
            <div>
                <DateTimePicker @bind-Value="_model.Birthday" DisplayText="生日" ShowLabel="true" />
            </div>
            <div>
                <Switch @bind-Value="_model.Active" DisplayText="启用" OnText="是" OffText="否" />
            </div>
        </Row>
        <Button Type="ButtonType.Submit" Color="Color.Primary" Text="提交" />
    </ValidateForm>
</div>

@code {
    [Inject] ToastService ToastService { get; set; } = null!;

    private DemoModel _model = new();

    private readonly List<SelectedItem> _cities = new()
    {
        new("bj", "北京"), new("sh", "上海"), new("gz", "广州"), new("sz", "深圳")
    };

    private Task OnSubmit(EditContext ctx)
    {
        ToastService.Success("提交成功", $"姓名：{_model.Name}");
        return Task.CompletedTask;
    }

    private Task OnSuccess() => ToastService.Success("操作", "成功！");

    public class DemoModel
    {
        [Required] public string Name { get; set; } = "";
        public string? City { get; set; }
        public DateTime? Birthday { get; set; }
        public bool Active { get; set; } = true;
    }
}
